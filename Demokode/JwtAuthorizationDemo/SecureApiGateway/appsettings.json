{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SecureApiGatewayDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "ReverseProxy": {
    "Routes": {
      "weather-route": {
        "ClusterId": "weather-cluster",
        "AuthorizationPolicy": "customPolicy",
        "Match": {
          "Path": "/weather/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "weather-route2": {
        "ClusterId": "weather-cluster",
        "AuthorizationPolicy": "adminPolicy",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "weather-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://weather.api:8080"
          }
        }
      }
    }


  }

}
